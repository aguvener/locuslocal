# WebMCP origin trial token for the deployed origin. Injected into
# <meta http-equiv="origin-trial"> at build time by the origin-trial-meta
# plugin in vite.config.ts. Register your own origin at
# https://developer.chrome.com/blog/ai-webmcp-origin-trial
#
# Optional: without it the app still runs, and feature-detects
# document.modelContext behind chrome://flags/#enable-webmcp-testing.
VITE_ORIGIN_TRIAL_TOKEN=
